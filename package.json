{
  "name": "dsh-highlightpin",
  "version": "0.1.2",
  "description": "Three-level source-text pins: recall, resident background, and highlighted constraints for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "sbearbug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbearbug/dsh-highlightpin.git"
  },
  "homepage": "https://github.com/sbearbug/dsh-highlightpin#readme",
  "bugs": {
    "url": "https://github.com/sbearbug/dsh-highlightpin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "pin",
    "context-compaction",
    "system-prompt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "docs/PROBES.md",
    "docs/m1-live-0.1.4.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "DESIGN.md",
    "EVAL.md",
    "CHANGELOG.md",
    "LICENSE",
    "eval",
    "test"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && node test/bundle.mjs",
    "eval": "node eval/deterministic.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
